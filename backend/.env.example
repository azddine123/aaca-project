# Security (Required: must be at least 32 characters)
SECRET_KEY=your_very_secure_random_string_of_at_least_32_characters_here

# API Configuration
# Set to true only in development — disables /docs and /redoc in production
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Database (MongoDB)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=aaca_db

# LLM Providers (At least one is required for text generation)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Processing Configuration
ENABLE_LLM_CACHE=True
LLM_CACHE_TTL=3600
OCR_ENGINE=paddleocr
OCR_CONFIDENCE_THRESHOLD=0.8
MAX_PROCESSING_TIME=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

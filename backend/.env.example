# Security (Required: must be at least 32 characters)
SECRET_KEY=your_very_secure_random_string_of_at_least_32_characters_here

# API Configuration
# Set to true only in development — disables /docs and /redoc in production
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8000
# When DEBUG=true, any localhost/private-LAN origin (10.x/172.16-31.x/192.168.x)
# is already allowed automatically (see CORS_ORIGIN_REGEX in config.py) — no
# need to list a phone's IP here. In production, set an explicit allow-list:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Database (MongoDB)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=aaca_db

# LLM Providers (At least one is required for text generation)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Processing Configuration
ENABLE_LLM_CACHE=True
LLM_CACHE_TTL=3600
OCR_ENGINE=paddleocr
OCR_CONFIDENCE_THRESHOLD=0.8
MAX_PROCESSING_TIME=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# SMTP email delivery for password reset OTPs.
# For Gmail, enable 2-step verification and generate an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password-without-spaces
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=PicLearn
SMTP_USE_TLS=true

PASSWORD_RESET_OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5

# Rate limiting (optionnel) — "memory://" par defaut (mono-worker uniquement).
# En prod multi-workers / derriere un proxy : Redis + uvicorn --proxy-headers
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379

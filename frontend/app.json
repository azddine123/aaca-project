{
  "expo": {
    "name": "PicLearn",
    "slug": "aaca-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/piclearn-main-logo.png",
    "scheme": "aacamobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "PicLearn utilise la caméra pour capturer vos notes académiques.",
        "NSPhotoLibraryUsageDescription": "PicLearn accède à vos photos pour importer des notes.",
        "NSPhotoLibraryAddUsageDescription": "PicLearn enregistre automatiquement les photos prises dans votre galerie."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/piclearn-main-logo.png",
        "backgroundColor": "#0F172A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.aaca.mobile",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/piclearn-main-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/piclearn-main-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser PicLearn à utiliser la caméra pour capturer vos notes."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "PicLearn accède à vos photos pour importer des notes.",
          "savePhotosPermission": "PicLearn enregistre automatiquement les photos prises dans votre galerie.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "revenueCatIosApiKey": "test_AcyfMrkZkJQpHRErNpCTkHmkJMC",
      "revenueCatAndroidApiKey": "test_AcyfMrkZkJQpHRErNpCTkHmkJMC"
    }
  }
}